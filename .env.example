# Banco exclusivo do Zailom Pay. Gere uma senha forte e única.
POSTGRES_USER=zailom_pay
POSTGRES_DB=zailom_pay
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET

# URLs públicas
APP_ORIGIN=https://pay.zailom.com
API_PUBLIC_URL=https://api-pay.zailom.com

# Primeiro acesso administrativo (obrigatório para criar o superadmin inicial)
ADMIN_EMAIL=admin@zailom.com
ADMIN_PASSWORD=CHANGE_ME_WITH_AT_LEAST_14_CHARACTERS
ADMIN_NAME=Administrador Zailom
